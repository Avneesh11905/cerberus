################################################################################
# ==============================================================================
#                      BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
################################################################################

############################################################
# APPLICATION / CORE
############################################################

VERSION="1.0"
ENV="development"
API_BASE_URL=http://localhost:8000
FRONTEND_URL="https://myapp.example.com"
CORS_ORIGINS="https://myapp.example.com,https://admin.myapp.example.com"

############################################################
# LOGS
############################################################

LOG_LEVEL=INFO
LOG_RETENTION_DAYS=28

############################################################
# ADMINISTRATION
############################################################

SUPERADMIN_EMAIL="superadmin@example.com"
ACCOUNT_RETENTION_DAYS=30

############################################################
# DATABASE
############################################################

PGSQL_URL="postgresql://postgres:password@db:5432/postgres"

############################################################
# REDIS - CELERY / CACHE
############################################################

CACHE_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_URL="redis://redis:6379/2"

############################################################
# SECURITY & JWT
############################################################

SESSION_SECRET="your-32-byte-secret-for-oauth-sessions"
ENCRYPTION_KEY="your_encryption_key"
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
TOKEN_ACCESS_TOKEN_LIFETIME_MINUTES=15
TOKEN_REFRESH_TOKEN_LIFETIME_DAYS=7

############################################################
# OTP & VERIFICATION
############################################################

VERIFICATION_OTP_EXPIRATION_SECONDS=300
VERIFICATION_OTP_RESEND_WINDOW_SECONDS=900
VERIFICATION_OTP_MAX_ATTEMPTS=5
VERIFICATION_PASSWORD_RESET_EXPIRY_SECONDS=900

############################################################
# THIRD-PARTY: OAUTH
############################################################

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

############################################################
# THIRD-PARTY: EMAIL
############################################################

EMAIL_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@resend.dev"
EMAIL_REPLY_TO="YourName <email@gmail.com>"
EMAIL_TEMPLATE_NAME="modern"

############################################################
# THIRD-PARTY: CAPTCHA (TURNSTILE)
############################################################

TURNSTILE_SECRET_KEY=""

############################################################
# RATE LIMITING
############################################################

RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_AUTH="10/minute"


